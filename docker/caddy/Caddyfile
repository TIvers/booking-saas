booking.iversdev.ru {
	encode gzip zstd

	handle /api/* {
		reverse_proxy backend-nginx:80
	}

	handle /sanctum/* {
		reverse_proxy backend-nginx:80
	}

	handle /broadcasting/* {
		reverse_proxy backend-nginx:80
	}

	handle /app/* {
		uri strip_prefix /app
		reverse_proxy reverb:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
